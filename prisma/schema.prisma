generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  KITCHEN
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  TAB
}

enum PaymentStatus {
  PAID
  PENDING
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
}

enum FiscalStatus {
  NOT_EMITTED
  PENDING
  AUTHORIZED
  REJECTED
}

enum GatewayProvider {
  NONE
  FOCUS_NFE
  PLUGNOTAS
  NFEIO
}

enum FiscalEnvironment {
  SANDBOX
  PRODUCTION
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(SELLER)
  createdAt    DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("users")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  category      String
  price         Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  ncm           String?
  cfop          String?
  minStockAlert Int?     @map("min_stock_alert")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  orderItems OrderItem[]

  @@map("products")
}

model Client {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String?
  cpf            String?
  cnpj           String?
  dueDay         Int?     @map("due_day")
  creditLimit    Decimal  @default(0) @db.Decimal(10, 2) @map("credit_limit")
  currentBalance Decimal  @default(0) @db.Decimal(10, 2) @map("current_balance")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  // Endereço — opcional, mas exigido pela NFe.io (buyer.address) pra emitir nota fiscal em nome
  // desse cliente. Sem esses campos preenchidos, a emissão via NFe.io falha com erro explícito.
  addressStreet     String? @map("address_street")
  addressNumber     String? @map("address_number")
  addressDistrict   String? @map("address_district")
  addressCity       String? @map("address_city")
  addressCityCode   String? @map("address_city_code") // código IBGE do município (7 dígitos)
  addressState      String? @map("address_state")
  addressPostalCode String? @map("address_postal_code")

  orders   Order[]
  payments ClientPayment[]

  @@map("clients")
}

model ClientPayment {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])

  @@map("client_payments")
}

model Order {
  id            Int           @id @default(autoincrement())
  sellerId      Int           @map("seller_id")
  clientId      Int?          @map("client_id")
  totalAmount   Decimal       @db.Decimal(10, 2) @map("total_amount")
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  kitchenStatus KitchenStatus @default(PENDING) @map("kitchen_status")
  fiscalStatus  FiscalStatus  @default(NOT_EMITTED) @map("fiscal_status")
  fiscalKey     String?       @map("fiscal_key")
  fiscalError   String?       @map("fiscal_error")
  createdAt     DateTime      @default(now()) @map("created_at")

  seller User    @relation(fields: [sellerId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
  items  OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model FiscalSettings {
  id              Int               @id @default(autoincrement())
  companyName     String?           @map("company_name")
  cnpj            String?
  icmsRate        Decimal           @default(0) @db.Decimal(5, 2) @map("icms_rate")
  gatewayProvider GatewayProvider   @default(NONE) @map("gateway_provider")
  gatewayApiKey   String?           @map("gateway_api_key")
  // Id da empresa no gateway — só a NFe.io exige isso hoje (Focus NFe/PlugNotas identificam a
  // empresa pelo CNPJ + api key). Fica genérico pra não amarrar o schema a um provedor específico.
  gatewayCompanyId String?          @map("gateway_company_id")
  environment     FiscalEnvironment @default(SANDBOX)

  // Reforma Tributária (IBS/CBS) — Grupo UB, obrigatório em toda NFC-e a partir de 2026.
  // Alíquotas de teste oficiais pra 2026 (Ato Conjunto RFB/CGIBS Nº 1/2025): CBS 0,9%, IBS 0,1%
  // inteiro pra UF e 0% pro Município — só a partir de 2027 o IBS passa a dividir 0,05%/0,05%.
  // CONFIRME com seu contador/a Focus NFe antes de considerar isso válido para produção.
  cbsRate                       Decimal @default(0.9) @db.Decimal(6, 4) @map("cbs_rate")
  ibsUfRate                     Decimal @default(0.1) @db.Decimal(6, 4) @map("ibs_uf_rate")
  ibsMunRate                    Decimal @default(0) @db.Decimal(6, 4) @map("ibs_mun_rate")
  ibsCbsSituacaoTributaria      String  @default("000") @map("ibs_cbs_situacao_tributaria")
  ibsCbsClassificacaoTributaria String  @default("000001") @map("ibs_cbs_classificacao_tributaria")
  // Código IBGE do município (7 dígitos) do fato gerador do IBS/CBS — obrigatório (cMunFGIBS).
  ibsCbsMunicipioCodigo         String? @map("ibs_cbs_municipio_codigo")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fiscal_settings")
}
