generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  KITCHEN
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  TAB
}

enum PaymentStatus {
  PAID
  PENDING
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
}

enum FiscalStatus {
  NOT_EMITTED
  PENDING
  AUTHORIZED
  REJECTED
}

enum FiscalType {
  NFCE
  NFE
}

enum GatewayProvider {
  NONE
  FOCUS_NFE
  PLUGNOTAS
  NFEIO
}

enum FiscalEnvironment {
  SANDBOX
  PRODUCTION
}

// Banco/adquirente da maquininha de cartão integrada ao PDV.
enum PaymentProvider {
  NONE
  MERCADO_PAGO
  SUMUP
}

enum TerminalPaymentStatus {
  PENDING
  APPROVED
  CANCELED
  FAILED
  REFUNDED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(SELLER)
  createdAt    DateTime @default(now()) @map("created_at")

  orders           Order[]
  terminalPayments TerminalPayment[]

  @@map("users")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  category      String
  price         Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  ncm           String?
  cfop          String?
  minStockAlert Int?     @map("min_stock_alert")
  imageUrl      String?  @map("image_url")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  orderItems OrderItem[]

  @@map("products")
}

model Client {
  id                Int      @id @default(autoincrement())
  name              String
  phone             String?
  cpf               String?
  cnpj              String?
  // Inscrição Estadual — só preencher se o cliente for contribuinte de ICMS (ex: revendedor). Sem
  // isso, a SEFAZ rejeita NF-e pra clientes PJ que têm IE ativa no cadastro dela mesmo se a gente
  // mandar "não contribuinte" (rejeição 232, testado ao vivo em 2026-08-26).
  stateRegistration String?  @map("state_registration")
  dueDay            Int?     @map("due_day")
  creditLimit       Decimal  @default(0) @map("credit_limit") @db.Decimal(10, 2)
  currentBalance    Decimal  @default(0) @map("current_balance") @db.Decimal(10, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")

  // Endereço — opcional, mas exigido pela NFe.io (buyer.address) pra emitir nota fiscal em nome
  // desse cliente. Sem esses campos preenchidos, a emissão via NFe.io falha com erro explícito.
  addressStreet     String? @map("address_street")
  addressNumber     String? @map("address_number")
  addressDistrict   String? @map("address_district")
  addressCity       String? @map("address_city")
  addressCityCode   String? @map("address_city_code") // código IBGE do município (7 dígitos)
  addressState      String? @map("address_state")
  addressPostalCode String? @map("address_postal_code")

  orders   Order[]
  payments ClientPayment[]

  @@map("clients")
}

model ClientPayment {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])

  @@map("client_payments")
}

model Order {
  id             Int           @id @default(autoincrement())
  sellerId       Int           @map("seller_id")
  clientId       Int?          @map("client_id")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentStatus  PaymentStatus @default(PAID) @map("payment_status")
  kitchenStatus  KitchenStatus @default(PENDING) @map("kitchen_status")
  fiscalStatus   FiscalStatus  @default(NOT_EMITTED) @map("fiscal_status")
  fiscalType     FiscalType?   @map("fiscal_type")
  fiscalKey      String?       @map("fiscal_key")
  fiscalError    String?       @map("fiscal_error")
  // Links pro documento no servidor da Focus NFe (DANFE em HTML e o XML da nota) — só preenchidos
  // quando AUTHORIZED. Precisam ser resolvidos com o host correto (homologação/produção) no
  // momento da emissão, já que a resposta da Focus só devolve o caminho relativo.
  fiscalDanfeUrl String?       @map("fiscal_danfe_url")
  fiscalXmlUrl   String?       @map("fiscal_xml_url")
  createdAt      DateTime      @default(now()) @map("created_at")

  seller          User             @relation(fields: [sellerId], references: [id])
  client          Client?          @relation(fields: [clientId], references: [id])
  items           OrderItem[]
  terminalPayment TerminalPayment?

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model FiscalSettings {
  id               Int               @id @default(autoincrement())
  companyName      String?           @map("company_name")
  cnpj             String?
  icmsRate         Decimal           @default(0) @map("icms_rate") @db.Decimal(5, 2)
  gatewayProvider  GatewayProvider   @default(NONE) @map("gateway_provider")
  gatewayApiKey    String?           @map("gateway_api_key")
  // Id da empresa no gateway — só a NFe.io exige isso hoje (Focus NFe/PlugNotas identificam a
  // empresa pelo CNPJ + api key). Fica genérico pra não amarrar o schema a um provedor específico.
  gatewayCompanyId String?           @map("gateway_company_id")
  environment      FiscalEnvironment @default(SANDBOX)

  // Reforma Tributária (IBS/CBS) — Grupo UB, obrigatório em toda NFC-e a partir de 2026.
  // Alíquotas de teste oficiais pra 2026 (Ato Conjunto RFB/CGIBS Nº 1/2025): CBS 0,9%, IBS 0,1%
  // inteiro pra UF e 0% pro Município.
  //
  // GOTCHA investigado ao vivo em 2026-08-25 contra a SEFAZ-SP homologação, CNPJ
  // 54.926.669/0001-38 (Focus NFe): com ibs_uf_aliquota=0.1 (valor oficial) a SEFAZ rejeita
  // consistentemente com "Rejeição: CNPJ Emitente não cadastrado" — mensagem enganosa, o CNPJ
  // em si está cadastrado certinho (confirmado isolando o payload campo a campo). Testar
  // ibs_uf_aliquota=0.9 também rejeita, mas com "Alíquota do IBS da UF inválida" (ou seja, 0.9
  // nem é um valor aceito — não use). Hipótese mais provável: esse CNPJ ainda não está
  // habilitado pela SEFAZ/Focus especificamente pro grupo de testes da Reforma Tributária
  // (cadastro separado do cadastro comum de NFC-e) — precisa confirmar com o suporte da Focus
  // NFe. Um "autorizado" isolado que apareceu num teste manual veio com
  // "contingencia_offline": true (SEFAZ fora do ar naquele instante, validação mais frouxa) —
  // não é reprodutível, foi sorte de timing, não uma configuração válida.
  cbsRate                       Decimal @default(0.9) @map("cbs_rate") @db.Decimal(6, 4)
  ibsUfRate                     Decimal @default(0.1) @map("ibs_uf_rate") @db.Decimal(6, 4)
  ibsMunRate                    Decimal @default(0) @map("ibs_mun_rate") @db.Decimal(6, 4)
  ibsCbsSituacaoTributaria      String  @default("000") @map("ibs_cbs_situacao_tributaria")
  ibsCbsClassificacaoTributaria String  @default("000001") @map("ibs_cbs_classificacao_tributaria")
  // Código IBGE do município (7 dígitos) do fato gerador do IBS/CBS — obrigatório (cMunFGIBS).
  ibsCbsMunicipioCodigo         String? @map("ibs_cbs_municipio_codigo")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fiscal_settings")
}

model PaymentSettings {
  id         Int             @id @default(autoincrement())
  provider   PaymentProvider @default(NONE)
  // Token da API do banco (Mercado Pago: Access Token de produção; SumUp: API key).
  apiKey     String?         @map("api_key")
  // Id da conta no banco — só a SumUp exige (merchant code). O Mercado Pago identifica pela apiKey.
  accountId  String?         @map("account_id")
  terminalId String?         @map("terminal_id")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@map("payment_settings")
}

// Cada cobrança enviada pra maquininha. A venda (Order) só é criada depois que a cobrança fica
// APPROVED, e aí fica vinculada aqui via orderId — uma cobrança aprovada vale pra uma venda só.
model TerminalPayment {
  id             Int                   @id @default(autoincrement())
  provider       PaymentProvider
  providerId     String                @map("provider_id")
  terminalId     String                @map("terminal_id")
  amount         Decimal               @db.Decimal(10, 2)
  status         TerminalPaymentStatus @default(PENDING)
  providerStatus String?               @map("provider_status")
  statusDetail   String?               @map("status_detail")
  // Tipo de pagamento que o cliente escolheu na maquininha (ex: credit_card, debit_card, qr).
  paymentType    String?               @map("payment_type")
  sellerId       Int                   @map("seller_id")
  orderId        Int?                  @unique @map("order_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  seller User   @relation(fields: [sellerId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([status])
  @@map("terminal_payments")
}
